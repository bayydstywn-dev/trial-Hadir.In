generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(uuid())
  name        String
  email       String       @unique
  phone       String?      @unique
  password    String
  role        Role         @default(EMPLOYEE)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attendances Attendance[]
  logbooks    Logbook[]

  @@map("users")
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  code      String
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  expiredAt DateTime

  @@map("otps")
}

model Attendance {
  id        String           @id @default(uuid())
  userId    String
  date      DateTime         @db.Date
  clockIn   DateTime         @db.Time(6)
  clockOut  DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  status    AttendanceStatus @default(PRESENT)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("attendances")
}

model Logbook {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime @db.Date
  description String
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("logbooks")
}

enum Role {
  ADMIN
  EMPLOYEE
  INTERN
}

enum AttendanceStatus {
  PRESENT
  LATE
}
